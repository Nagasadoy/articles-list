{% extends 'app/base.html.twig' %}

{% block body %}
    <h3>{{ article.title }}</h3>
    <div class="article-content">
        <div>
            {{ article.description }}
        </div>
    </div>

    <div class="article-stats-info">
        <div>
            Количество просмотров: {{ views_count_format(article.countViews) }}
        </div>
        <div>
            Статья активна: {{ is_enabled_format(article.isEnabled) }}
        </div>
        <div>
            Дата создания: {{ article.createdAt|date('Y.m.d H:i') }}
        </div>
    </div>

    <div class="article-btn-back-to-list">
        <a href={{ path('article_list') }}>Назад к списку статей</a>
    </div>
{% endblock %}
